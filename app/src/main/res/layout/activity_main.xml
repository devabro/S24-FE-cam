<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Preview + overlays. Zebra bitmap is scaled over the preview; histogram sits at its bottom. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <TextureView
            android:id="@+id/preview_texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/zebra_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <com.s24fe.nativecamera.ui.HistogramView
            android:id="@+id/histogram_view"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="#40000000" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starting…" />

            <TextView
                android:id="@+id/tv_raw_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/lens_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_capture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Photo" />

                <Button
                    android:id="@+id/btn_record"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Record video" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_natural"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Natural mode (no forced sharpening / smoothing)" />

            <Switch
                android:id="@+id/switch_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOG video (10-bit HLG)" />

            <TextView
                android:id="@+id/tv_log_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_iso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ISO auto" />

            <SeekBar
                android:id="@+id/seek_iso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_shutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shutter auto" />

            <SeekBar
                android:id="@+id/seek_shutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual focus (0 = infinity, 100 = closest)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seek_focus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_focus_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="White balance" />

            <Spinner
                android:id="@+id/spinner_wb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_zebra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zebra 235" />

            <SeekBar
                android:id="@+id/seek_zebra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_auto_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset to auto" />

            <EditText
                android:id="@+id/et_preset_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Preset name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_preset_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save preset" />

                <Button
                    android:id="@+id/btn_preset_load"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Load preset" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinner_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LUT loading (.cube) is v2 — v1 LOG files are graded in editing." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
